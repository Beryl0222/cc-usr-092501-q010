{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "社区肝病队列治理领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "事件全局唯一标识；一旦接收不得原地复用为另一份内容"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PARTICIPANT_ENROLLED",
        "LINKAGE_RECORDED",
        "CONSENT_RECORDED",
        "WITHDRAWAL_APPLIED",
        "DEVICE_REGISTERED",
        "DEVICE_CALIBRATED",
        "QUESTIONNAIRE_PUBLISHED",
        "RULE_PUBLISHED",
        "VISIT_RECORDED",
        "QUESTIONNAIRE_RESPONSE_RECORDED",
        "NITX_RESULT_RECORDED",
        "RISK_STRATIFIED",
        "REFERRAL_RECORDED",
        "REFERRAL_UPDATED",
        "FOLLOWUP_STATUS_RECORDED",
        "UPLOAD_ACCEPTED",
        "BATCH_QUARANTINED",
        "ANALYSIS_LOCKED",
        "ANALYSIS_UNLOCKED",
        "ANALYSIS_FROZEN",
        "SNAPSHOT_PUBLISHED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "participant_link",
        "study_visit",
        "site_upload",
        "analysis_snapshot",
        "device",
        "questionnaire",
        "rule_definition",
        "referral"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
